# ÖRNEK ÇEVRE DEĞİŞKENLERİ (.env.example)
# Bu uygulamada açık kaynaklı genel servisler (OSRM ve Nominatim) kullanıldığı için
# doğrudan API anahtarı zorunluluğu bulunmamaktadır.
# Özel bir rota veya harita sağlayıcısı kullanmak isterseniz aşağıdaki değişkenleri tanımlayabilirsiniz.

# Özel OSRM Sunucu Uç Noktası (Opsiyonel)
VITE_OSRM_API_URL=https://router.project-osrm.org/route/v1/driving/

# Özel Geocoding Sunucu Uç Noktası (Opsiyonel)
VITE_NOMINATIM_API_URL=https://nominatim.openstreetmap.org/search

# Harita Karo Sağlayıcısı (Opsiyonel)
VITE_TILE_SERVER_URL=https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png

